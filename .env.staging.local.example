APP_ENV=staging
NODE_ENV=production
NODE_ROLE=standalone
TZ=Asia/Jakarta

HOSTNAME=127.0.0.1
PORT=5010
API_HOST=127.0.0.1
API_PORT=7010
STAGING_WEB_ORIGIN=http://127.0.0.1:5010

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=maknaflow_staging
PGPASSWORD=change_this_local_password
PGDATABASE=maknaflow_staging
PG_SEARCH_PATH=public
PGPOOL_MAX=4

STAGING_ADMIN_USERNAME=admin
STAGING_ADMIN_PASSWORD=change_this_admin_password

ENABLE_BACKGROUND_SERVICES=false
ENABLE_CAMPAIGN_SCHEDULER=false
ENABLE_SCHEDULER_WORKER=false
ENABLE_OPERATOR_WORKER=false
MAKNA_SCHEDULER=0

# Headless Operator API (generate with: openssl rand -hex 32)
MAKNA_OPERATOR_API_TOKEN=replace_with_a_long_random_secret
MAKNA_OPERATOR_TENANT_ID=default_tenant
MAKNA_OPERATOR_BASE_URL=http://127.0.0.1:5010
OPERATOR_WORKER_INTERVAL_MS=3000
OPERATOR_JOB_LOCK_TIMEOUT_MS=300000

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WEBHOOK_ENABLED=false
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
CONTENT_FLOW_SYNC_ENABLED=false
NEXTCLOUD_SYNC_ENABLED=false
GOOGLE_INTEGRATION_ENABLED=false
SOCIAL_POSTING_ENABLED=false
