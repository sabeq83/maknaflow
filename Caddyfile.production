# ==============================================================================
# Caddyfile for Node 1 Gateway (MAKNA Grid & MAKNA Flow)
# Path: /etc/caddy/Caddyfile
# ==============================================================================

# MAKNA Grid Production
nuc-desktop.tail8194e4.ts.net {
    reverse_proxy 127.0.0.1:3000
    
    # Use Caddy's internal Certificate Authority (self-signed)
    tls internal
    
    log {
        output file /var/log/caddy/maknagrid_access.log
    }
}

# MAKNA Flow Production
nuc-desktop.tail8194e4.ts.net:8443 {
    reverse_proxy 127.0.0.1:5000
    
    # Use Caddy's internal Certificate Authority (self-signed)
    tls internal
    
    log {
        output file /var/log/caddy/maknaflow_access.log
    }
}
