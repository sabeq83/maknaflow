# ==============================================================================
# Caddyfile configuration snippet for MAKNA Flow
# Add this snippet to /etc/caddy/Caddyfile on Node 1 (nuc-desktop)
# ==============================================================================

nuc-desktop.tail8194e4.ts.net:8443 {
    # Reverse proxy to Next.js production port 5000
    reverse_proxy 127.0.0.1:5000

    # Auto-SSL via Tailscale local certificate authority
    tls internal

    # Enable logging
    log {
        output file /var/log/caddy/maknaflow_access.log
    }
}
